{
  "name": "agro-erp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint && node scripts/naming-audit.mjs && node scripts/member-farms-audit.mjs && node scripts/notification-insert-audit.mjs && node scripts/notification-matrix.mjs --check && node scripts/farm-inventory.mjs --check && node scripts/data-dictionary.mjs --check",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @agro/db test:integration && pnpm --filter @agro/api test:integration",
    "build": "pnpm -r --if-present build",
    "db:migrate": "pnpm --filter @agro/db migrate",
    "db:seed": "pnpm --filter @agro/db seed",
    "db:reset": "pnpm --filter @agro/db reset",
    "dev:api": "pnpm --filter @agro/api dev",
    "dev:web": "pnpm --filter @agro/web dev",
    "e2e": "pnpm --filter @agro/web e2e",
    "parity": "node scripts/parity.mjs",
    "parity:check": "node scripts/parity.mjs --check",
    "db:seed:e2e": "DATABASE_URL=${E2E_DATABASE_URL:-postgresql://postgres@127.0.0.1:5433/agro_erp_e2e} pnpm --filter @agro/db exec tsx src/cli.ts seed",
    "audit:naming": "node scripts/naming-audit.mjs",
    "audit:member-farms": "node scripts/member-farms-audit.mjs",
    "audit:notifications": "node scripts/notification-insert-audit.mjs && node scripts/notification-matrix.mjs --check",
    "audit:farm": "node scripts/farm-inventory.mjs --check",
    "audit:dictionary": "node scripts/data-dictionary.mjs --check",
    "docs:generate": "node scripts/farm-inventory.mjs && node scripts/data-dictionary.mjs && node scripts/notification-matrix.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
