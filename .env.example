# ---------- Banco (Supabase/PostgreSQL) ----------
# Conexão usada pela API (Railway) e pelo runner de migrations. Nunca exponha no frontend.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agro_erp
# Conexão para testes de integração (banco descartável)
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/agro_erp_test

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Somente backend (Railway). NUNCA em NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Segredo JWT do projeto Supabase (Settings > API) usado pela API para validar tokens.
SUPABASE_JWT_SECRET=<jwt-secret>

# ---------- API (Railway) ----------
PORT=3333
HOST=0.0.0.0
API_LOG_LEVEL=info
# Origens do frontend permitidas no CORS, separadas por vírgula (conforme docs/DEPLOYMENT.md § Superfície web)
WEB_ORIGIN=http://localhost:3000
# Sufixos de host dos previews DESTE projeto, separados por vírgula. Vazio = nenhum preview aceito.
# Formato obrigatório de cada item: -<conta>.vercel.app   (ex.: -minhaconta.vercel.app)
# O VALOR É VERIFICADO NO STARTUP e um valor fora desse formato DERRUBA O PROCESSO — não é um aviso.
# São RECUSADOS, sem correção silenciosa: .vercel.app e vercel.app (raiz do provedor), *.vercel.app,
# esquema colado (https://…), porta, caminho, credencial embutida, conta com ponto e caractere fora do
# ASCII imprimível. O motivo é que a API responde com credentials: um sufixo genérico entregaria a API
# autenticada a qualquer conta daquele provedor. O erro de startup NÃO imprime o valor recusado, só a
# posição dele na lista — este campo fica ao lado dos que guardam DSN e token.
# Ver docs/SECURITY.md (inclusive o LIMITE declarado da âncora) e apps/api/src/lib/cors-origem.ts.
WEB_ORIGIN_PREVIEW_SUFFIX=
# Modo de autenticação local sem Supabase: "local" usa tabela auth_local_users (dev/test); "supabase" valida JWT do Supabase.
AUTH_MODE=local
# Segredo para assinar sessões no modo local
LOCAL_AUTH_SECRET=change-me-in-dev
# Gate da execução configurada da TOP (TOP-CONFIG-04A). Ausente ou 0 = DESLIGADO (o padrão); 1 = ligado.
# Qualquer outro valor DERRUBA O STARTUP. Desligado, a ativação é recusada e a confirmação de uma venda cuja
# versão declara execução configurada é RECUSADA — nunca confirmada pelo comportamento legado. Ligar é a
# fase 2 da implantação (docs/DEPLOYMENT.md § TOP-CONFIG-04A). Só a API lê; o web não tem par.
TOP_EFFECTS_RUNTIME_V1_ENABLED=0

# ---------- Web — variáveis de frontend; topologia em docs/DEPLOYMENT.md § Superfície web ----------
NEXT_PUBLIC_API_URL=http://localhost:3333
# Só em ambientes de demonstração: exibe as credenciais demo na tela de login. Nunca defina em produção.
NEXT_PUBLIC_DEMO_MODE=false
