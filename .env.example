# ---------- Banco (Supabase/PostgreSQL) ----------
# Conexão usada pela API (Railway) e pelo runner de migrations. Nunca exponha no frontend.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agro_erp
# Conexão para testes de integração (banco descartável)
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/agro_erp_test

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Somente backend (Railway). NUNCA em NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Segredo JWT do projeto Supabase (Settings > API) usado pela API para validar tokens.
SUPABASE_JWT_SECRET=<jwt-secret>

# ---------- API (Railway) ----------
PORT=3333
HOST=0.0.0.0
API_LOG_LEVEL=info
# Origem permitida no CORS (URL do frontend na Vercel)
WEB_ORIGIN=http://localhost:3000
# Modo de autenticação local sem Supabase: "local" usa tabela auth_local_users (dev/test); "supabase" valida JWT do Supabase.
AUTH_MODE=local
# Segredo para assinar sessões no modo local
LOCAL_AUTH_SECRET=change-me-in-dev

# ---------- Web (Vercel) ----------
NEXT_PUBLIC_API_URL=http://localhost:3333
# Só em ambientes de demonstração: exibe as credenciais demo na tela de login. Nunca defina em produção.
NEXT_PUBLIC_DEMO_MODE=false
