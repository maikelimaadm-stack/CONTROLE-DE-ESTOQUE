      "success-light": { "$value": "{primitive.color.primary.100}", "$type": "color" },
      "error": { "$value": "#DC2626", "$type": "color" },
      "error-light": { "$value": "#FECACA", "$type": "color" },
      "info": { "$value": "{primitive.color.secondary.500}", "$type": "color" },
      "info-light": { "$value": "{primitive.color.secondary.100}", "$type": "color" }
    }
  },
  "alias": {
    "mg-accent": "#40DE63",
    "mg-accent-hover": "#36C956",
    "mg-blue": "#2899F5",
    "mg-red": "#DC2626",
    "mg-text-1": "#111827",
    "mg-bg-page": "#F0F2F5"
