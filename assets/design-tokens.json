      "primary-lighter": { "$value": "{primitive.color.primary.50}", "$type": "color" },
      "primary-dark": { "$value": "{primitive.color.primary.800}", "$type": "color" },
      "secondary": { "$value": "{primitive.color.secondary.500}", "$type": "color" },
      "secondary-hover": { "$value": "{primitive.color.secondary.600}", "$type": "color" },
      "secondary-light": { "$value": "{primitive.color.secondary.300}", "$type": "color" },
      "secondary-dark": { "$value": "{primitive.color.secondary.700}", "$type": "color" },
